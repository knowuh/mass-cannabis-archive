---
import '@fontsource/geist-sans';
import '@fontsource/geist-mono';
import '../styles/variables.css';
import Navigation from './Navigation.astro';
import SafetyFooter from './SafetyFooter.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Massachusetts Cannabis Archive" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | MA Cannabis Archive</title>
	</head>
	<body>
		<div class="layout">
			<Navigation />
			<main>
				<slot />
			</main>
			<SafetyFooter />
		</div>
	</body>
</html>

<style>
	.layout {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	main {
		flex: 1;
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem;
	}
</style>
