---
import '@fontsource/geist-sans';
import '@fontsource/geist-mono';
import '../styles/variables.css';
import SafetyFooter from './SafetyFooter.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Massachusetts Cannabis Archive" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | MA Cannabis Archive</title>
	</head>
	<body>
		<div class="layout">
			<main>
				<slot />
			</main>
			<SafetyFooter />
		</div>
		<script data-goatcounter="https://mass-can-archive.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
	</body>
</html>

<style>
	.layout {
		display: flex;
		flex-direction: column;
		height: 100vh;
		overflow: hidden;
	}

	main {
		flex: 1;
		width: 100%;
		padding: 0.75rem 1rem;
		display: flex;
		flex-direction: column;
		min-height: 0;
	}
</style>
