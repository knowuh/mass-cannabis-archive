	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.label {
		font-weight: 700;
		margin-right: 0.5rem;
		color: var(--text-base);
	}

	.helpline a {
		color: var(--accent-color);
		text-decoration: none;
		font-family: var(--font-mono);
	}

	.disclaimer {
		font-style: italic;
	}

	@media (max-width: 768px) {
		.container {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
