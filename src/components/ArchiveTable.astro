---
import TableRow from './TableRow.astro';
import FilterSelect from './FilterSelect.astro';
import Pagination from './Pagination.astro';
import DetailsPane from './DetailsPane.astro';
---

<div class="archive-wrapper">
	<div class="data-browser">
		<div class="controls">
			<div class="search-box">
				<input type="text" id="search" placeholder="Search Business Name, Email, or City..." aria-label="Search" />
				<button id="clear-filters" class="clear-btn">Clear Filters</button>
			</div>
			<div class="filters">
				<FilterSelect id="filter-type" label="Type" placeholder="All Types" />
				<FilterSelect id="filter-county" label="County" placeholder="All Counties" />
				<FilterSelect id="filter-city" label="City" placeholder="All Cities" />
				<FilterSelect id="filter-dbe" label="DBE Status" placeholder="All Statuses" />
				<FilterSelect id="filter-priority" label="Priority Type" placeholder="All Priorities" />
			</div>
		</div>

		<Pagination />

		<div class="table-scroll-container">
			<table id="archive-table">
				<thead>
					<tr>
						<th>Business Name</th>
						<th>Phone</th>
						<th>Email</th>
						<th>Type</th>
						<th>City</th>
						<th>Status</th>
					</tr>
				</thead>
				<tbody id="table-body">
					<tr>
						<td colspan="6" class="loading">Initializing archive...</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>

	<DetailsPane />
</div>

<TableRow />

<script>
	const searchInput = document.getElementById('search') as HTMLInputElement;
	const clearBtn = document.getElementById('clear-filters') as HTMLButtonElement;
	const tableBody = document.getElementById('table-body');
	const totalCountDisplay = document.getElementById('total-count');
	const currentRangeDisplay = document.getElementById('current-range');
	const pageInfoDisplay = document.getElementById('page-info');
	const prevBtn = document.getElementById('prev-page') as HTMLButtonElement;
	const nextBtn = document.getElementById('next-page') as HTMLButtonElement;
	
	const typeSelect = document.getElementById('filter-type') as HTMLSelectElement;
	const countySelect = document.getElementById('filter-county') as HTMLSelectElement;
	const citySelect = document.getElementById('filter-city') as HTMLSelectElement;
	const dbeSelect = document.getElementById('filter-dbe') as HTMLSelectElement;
	const prioritySelect = document.getElementById('filter-priority') as HTMLSelectElement;

	const detailsPane = document.getElementById('details-pane');
	const detailsContent = document.getElementById('details-content');

	const rowTemplate = document.getElementById('table-row-template') as HTMLTemplateElement;

	let allData = [];
	let filteredData = [];
	let currentPage = 1;
	let selectedLicenseNumber = null;
	const itemsPerPage = 50;

	async function init() {
		try {
			const response = await fetch(`${import.meta.env.BASE_URL}/data/ccc/latest.json`);
			allData = await response.json();
			
			// Initial population of dropdowns
			updateAllDropdowns();
			applyFilters();
		} catch (error) {
			console.error('Failed to load data:', error);
			if (tableBody) {
				tableBody.innerHTML = '<tr><td colspan="6" class="error">Error loading data.</td></tr>';
			}
		}
	}

	function updateAllDropdowns() {
		const currentFilters = getCurrentFilters();
		
		updateDropdown(typeSelect, 'LICENSE_TYPE', currentFilters, 'All Types');
		updateDropdown(countySelect, 'ESTABLISHMENT_COUNTY', currentFilters, 'All Counties');
		updateDropdown(citySelect, 'ESTABLISHMENT_CITY', currentFilters, 'All Cities');
		updateDropdown(dbeSelect, 'DBE', currentFilters, 'All Statuses');
		updateDropdown(prioritySelect, 'PRIORITY_REVIEW_TYPE', currentFilters, 'All Priorities');
	}

	function getCurrentFilters() {
		return {
			searchTerm: searchInput.value.toLowerCase(),
			type: typeSelect.value,
			county: countySelect.value,
			city: citySelect.value,
			dbe: dbeSelect.value,
			priority: prioritySelect.value
		};
	}

	function updateDropdown(select: HTMLSelectElement, key: string, currentFilters: any, placeholder: string) {
		const previousSelection = select.value;
		
		const possibleData = allData.filter(row => {
			const matchesSearch = !currentFilters.searchTerm || 
				(row.BUSINESS_NAME?.toLowerCase().includes(currentFilters.searchTerm)) ||
				(row.BUSINESS_EMAIL?.toLowerCase().includes(currentFilters.searchTerm)) ||
				(row.ESTABLISHMENT_CITY?.toLowerCase().includes(currentFilters.searchTerm));
			
			const matchesType = key === 'LICENSE_TYPE' || !currentFilters.type || row.LICENSE_TYPE === currentFilters.type;
			const matchesCounty = key === 'ESTABLISHMENT_COUNTY' || !currentFilters.county || row.ESTABLISHMENT_COUNTY === currentFilters.county;
			const matchesCity = key === 'ESTABLISHMENT_CITY' || !currentFilters.city || row.ESTABLISHMENT_CITY === currentFilters.city;
			const matchesDbe = key === 'DBE' || !currentFilters.dbe || row.DBE === currentFilters.dbe;
			const matchesPriority = key === 'PRIORITY_REVIEW_TYPE' || !currentFilters.priority || row.PRIORITY_REVIEW_TYPE === currentFilters.priority;

			return matchesSearch && matchesType && matchesCounty && matchesCity && matchesDbe && matchesPriority;
		});

		const values = [...new Set(possibleData.map(item => item[key]))]
			.filter(v => v && v !== "")
			.sort();

		select.innerHTML = `<option value="">${placeholder}</option>`;

		values.forEach(val => {
			const opt = document.createElement('option');
			opt.value = val;
			opt.textContent = val;
			if (val === previousSelection) opt.selected = true;
			select.appendChild(opt);
		});
	}

	function applyFilters() {
		const filters = getCurrentFilters();

		filteredData = allData.filter(row => {
			const matchesSearch = !filters.searchTerm || 
				(row.BUSINESS_NAME?.toLowerCase().includes(filters.searchTerm)) ||
				(row.BUSINESS_EMAIL?.toLowerCase().includes(filters.searchTerm)) ||
				(row.ESTABLISHMENT_CITY?.toLowerCase().includes(filters.searchTerm));
			
			const matchesType = !filters.type || row.LICENSE_TYPE === filters.type;
			const matchesCounty = !filters.county || row.ESTABLISHMENT_COUNTY === filters.county;
			const matchesCity = !filters.city || row.ESTABLISHMENT_CITY === filters.city;
			const matchesDbe = !filters.dbe || row.DBE === filters.dbe;
			const matchesPriority = !filters.priority || row.PRIORITY_REVIEW_TYPE === filters.priority;

			return matchesSearch && matchesType && matchesCounty && matchesCity && matchesDbe && matchesPriority;
		});

		currentPage = 1;
		updateAllDropdowns();
		renderTable();
	}

	function renderTable() {
		if (!tableBody || !rowTemplate) return;

		const total = filteredData.length;
		const totalPages = Math.ceil(total / itemsPerPage) || 1;
		
		if (currentPage > totalPages) currentPage = totalPages;

		const start = (currentPage - 1) * itemsPerPage;
		const end = Math.min(start + itemsPerPage, total);
		const pageData = filteredData.slice(start, end);

		tableBody.innerHTML = '';

		if (pageData.length === 0) {
			tableBody.innerHTML = '<tr><td colspan="6" class="empty">No matching records found.</td></tr>';
			totalCountDisplay.textContent = '0';
			currentRangeDisplay.textContent = '0-0';
			pageInfoDisplay.textContent = '1 / 1';
			updatePaginationControls(1);
			return;
		}

		pageData.forEach(row => {
			const clone = rowTemplate.content.cloneNode(true) as DocumentFragment;
			const tr = clone.querySelector('tr');
			
			tr.setAttribute('data-license', row.LICENSE_NUMBER);
			if (selectedLicenseNumber === row.LICENSE_NUMBER) tr.classList.add('selected');

			tr.querySelector('.business-name').textContent = row.BUSINESS_NAME || 'N/A';
			tr.querySelector('.phone-cell').textContent = row.BUSINESS_PHONE || 'N/A';
			tr.querySelector('.email-cell').textContent = row.BUSINESS_EMAIL || 'N/A';
			tr.querySelector('.license-type').textContent = row.LICENSE_TYPE || 'N/A';
			tr.querySelector('.establishment-city').textContent = row.ESTABLISHMENT_CITY || 'N/A';
			
			const statusTag = tr.querySelector('.status-tag');
			statusTag.textContent = row.LICENSE_STATUS || 'N/A';
			statusTag.setAttribute('data-status', row.LICENSE_STATUS_CATEGORY?.toLowerCase() || '');

			tr.addEventListener('click', () => {
				selectedLicenseNumber = row.LICENSE_NUMBER;
				showDetails(row);
				document.querySelectorAll('.clickable-row').forEach(r => r.classList.remove('selected'));
				tr.classList.add('selected');
			});

			tableBody.appendChild(clone);
		});

		totalCountDisplay.textContent = total.toString();
		currentRangeDisplay.textContent = `${total === 0 ? 0 : start + 1}-${end}`;
		pageInfoDisplay.textContent = `${currentPage} / ${totalPages}`;
		
		updatePaginationControls(totalPages);
	}

	function updatePaginationControls(totalPages: number) {
		prevBtn.disabled = currentPage <= 1;
		nextBtn.disabled = currentPage >= totalPages;
	}

	function showDetails(record: any) {
		if (!detailsContent) return;

		// Prioritized keys for a better reading experience
		const priorityKeys = [
			'BUSINESS_NAME', 'LICENSE_NUMBER', 'LICENSE_TYPE', 'LICENSE_STATUS',
			'ESTABLISHMENT_ADDRESS_1', 'ESTABLISHMENT_CITY', 'ESTABLISHMENT_ZIP', 'ESTABLISHMENT_COUNTY',
			'BUSINESS_EMAIL', 'BUSINESS_PHONE',
			'DBE', 'PRIORITY_REVIEW_TYPE', 'APPROVED_LICENSE_STAGE', 'COMMENCE_OPERATIONS_DATE'
		];

		// Filter out empty or N/A values entirely
		const entries = Object.entries(record).filter(([_, val]) => val && val !== "N/A" && val !== "");

		const sortedEntries = entries.sort(([keyA], [keyB]) => {
			const idxA = priorityKeys.indexOf(keyA);
			const idxB = priorityKeys.indexOf(keyB);
			
			if (idxA !== -1 && idxB !== -1) return idxA - idxB; // Both prioritized
			if (idxA !== -1) return -1; // Only A is prioritized
			if (idxB !== -1) return 1; // Only B is prioritized
			return keyA.localeCompare(keyB); // Neither prioritized, alphabetical
		});

		detailsContent.innerHTML = sortedEntries
			.map(([key, value]) => `
				<div class="detail-item">
					<div class="detail-key">${key.replace(/_/g, ' ')}</div>
					<div class="detail-value">${value}</div>
				</div>
			`).join('');
	}

	// Event Listeners
	searchInput?.addEventListener('input', applyFilters);
	
	countySelect.addEventListener('change', () => {
		citySelect.value = ''; // Reset city when county changes
		applyFilters();
	});

	[typeSelect, citySelect, dbeSelect, prioritySelect].forEach(s => {
		s.addEventListener('change', applyFilters);
	});

	clearBtn?.addEventListener('click', () => {
		searchInput.value = '';
		typeSelect.value = '';
		countySelect.value = '';
		citySelect.value = '';
		dbeSelect.value = '';
		prioritySelect.value = '';
		selectedLicenseNumber = null;
		applyFilters();
		
		// Clear details pane
		if (detailsContent) {
			detailsContent.innerHTML = '<div class="placeholder-msg">Select a record to view full details</div>';
		}
	});

	prevBtn?.addEventListener('click', () => {
		if (currentPage > 1) {
			currentPage--;
			renderTable();
		}
	});

	nextBtn?.addEventListener('click', () => {
		const totalPages = Math.ceil(filteredData.length / itemsPerPage);
		if (currentPage < totalPages) {
			currentPage++;
			renderTable();
		}
	});

	init();
</script>

<style>
	.archive-wrapper {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		height: calc(100vh - 5rem);
	}

	.data-browser {
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.controls {
		background: var(--surface-color);
		padding: var(--space-3);
		border: var(--border-width) solid var(--border-color);
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.search-box {
		display: flex;
		gap: var(--space-3);
	}

	.search-box input {
		flex: 1;
		background: var(--bg-color);
		border: var(--border-width) solid var(--border-color);
		color: var(--text-base);
		padding: var(--space-2) var(--space-3);
		font-family: var(--font-sans);
		font-size: var(--font-size-base);
	}

	.clear-btn {
		background: var(--bg-color);
		border: var(--border-width) solid var(--border-color);
		color: var(--text-muted);
		padding: 0 var(--space-4);
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		cursor: pointer;
		white-space: nowrap;
		transition: all 0.2s ease;
	}

	.clear-btn:hover {
		border-color: var(--text-base);
		color: var(--text-base);
		background: var(--surface-color);
	}

	.filters {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
		gap: var(--space-2);
	}

	.filter-group {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.filter-group label {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.filter-group select {
		background: var(--bg-color);
		border: var(--border-width) solid var(--border-color);
		color: var(--text-base);
		padding: var(--space-1);
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
	}

	.table-scroll-container {
		flex: 1;
		overflow-y: auto;
		border: var(--border-width) solid var(--border-color);
		background: var(--bg-color);
	}

	table {
		width: 100%;
		border-collapse: collapse;
		text-align: left;
		table-layout: fixed;
		font-family: var(--font-mono);
	}

	th {
		position: sticky;
		top: 0;
		background: var(--surface-color);
		padding: var(--space-3) var(--space-4);
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		color: var(--text-muted);
		border-bottom: var(--border-width-thick) solid var(--border-color);
		z-index: 10;
	}

	td {
		padding: var(--space-3) var(--space-4);
		border-bottom: var(--border-width) solid var(--border-color);
		font-size: var(--font-size-sm);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	:global(.clickable-row:nth-child(even) td) {
		background-color: var(--stripe-color);
	}

	.clickable-row {
		cursor: pointer;
	}

	/* Use :global() to target elements injected via innerHTML */
	:global(.clickable-row:hover td) {
		background-color: var(--hover-color) !important;
	}

	:global(.clickable-row.selected td) {
		background-color: var(--selection-bg) !important;
		color: var(--selection-text) !important;
		font-weight: 700 !important;
	}
	
	:global(.clickable-row.selected .status-tag) {
		border-color: var(--selection-text) !important;
		color: var(--selection-text) !important;
		font-weight: 700 !important;
	}

	.mono {
		font-family: var(--font-mono);
	}

	.business-name {
		font-weight: 600;
		width: 25%;
	}
	
	.phone-cell { width: 15%; }
	.email-cell { width: 20%; }

	.status-tag {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		padding: var(--space-1) var(--space-2);
		border: var(--border-width) solid var(--border-color);
		text-transform: uppercase;
	}

	.status-tag[data-status="active"] {
		border-color: var(--accent-color);
		color: var(--accent-color);
	}

	@media (max-width: 768px) {
		.search-box {
			flex-direction: column;
		}
	}
</style>
