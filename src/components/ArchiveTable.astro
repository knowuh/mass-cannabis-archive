---
---

<div class="archive-wrapper">
	<div class="data-browser">
		<div class="controls">
			<div class="search-box">
				<input type="text" id="search" placeholder="Search Business Name, License #, or City..." aria-label="Search" />
				<button id="clear-filters" class="clear-btn">Clear Filters</button>
			</div>
			<div class="filters">
				<div class="filter-group">
					<label for="filter-type">Type</label>
					<select id="filter-type"><option value="">All Types</option></select>
				</div>
				<div class="filter-group">
					<label for="filter-county">County</label>
					<select id="filter-county"><option value="">All Counties</option></select>
				</div>
				<div class="filter-group">
					<label for="filter-city">City</label>
					<select id="filter-city"><option value="">All Cities</option></select>
				</div>
				<div class="filter-group">
					<label for="filter-dbe">DBE Status</label>
					<select id="filter-dbe"><option value="">All Statuses</option></select>
				</div>
				<div class="filter-group">
					<label for="filter-priority">Priority Type</label>
					<select id="filter-priority"><option value="">All Priorities</option></select>
				</div>
			</div>
		</div>

		<div class="stats-bar">
			<div class="count-info">
				Showing <span id="current-range">0-0</span> of <span id="total-count">0</span> records
			</div>
			<div class="pagination">
				<button id="prev-page" disabled>Prev</button>
				<span id="page-info">1 / 1</span>
				<button id="next-page" disabled>Next</button>
			</div>
		</div>

		<div class="table-scroll-container">
			<table id="archive-table">
				<thead>
					<tr>
						<th>Business Name</th>
						<th>License #</th>
						<th>Type</th>
						<th>City</th>
						<th>Status</th>
					</tr>
				</thead>
				<tbody id="table-body">
					<tr>
						<td colspan="5" class="loading">Initializing archive...</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>

	<div id="details-pane" class="details-pane">
		<div class="pane-header">
			<h2>Record Details</h2>
		</div>
		<div id="details-content" class="details-content">
			<div class="placeholder-msg">Select a record to view full details</div>
		</div>
	</div>
</div>

<script>
	const searchInput = document.getElementById('search') as HTMLInputElement;
	const clearBtn = document.getElementById('clear-filters') as HTMLButtonElement;
	const tableBody = document.getElementById('table-body');
	const totalCountDisplay = document.getElementById('total-count');
	const currentRangeDisplay = document.getElementById('current-range');
	const pageInfoDisplay = document.getElementById('page-info');
	const prevBtn = document.getElementById('prev-page') as HTMLButtonElement;
	const nextBtn = document.getElementById('next-page') as HTMLButtonElement;
	
	const typeSelect = document.getElementById('filter-type') as HTMLSelectElement;
	const countySelect = document.getElementById('filter-county') as HTMLSelectElement;
	const citySelect = document.getElementById('filter-city') as HTMLSelectElement;
	const dbeSelect = document.getElementById('filter-dbe') as HTMLSelectElement;
	const prioritySelect = document.getElementById('filter-priority') as HTMLSelectElement;

	const detailsPane = document.getElementById('details-pane');
	const detailsContent = document.getElementById('details-content');

	let allData = [];
	let filteredData = [];
	let currentPage = 1;
	let selectedLicenseNumber = null;
	const itemsPerPage = 50;

	async function init() {
		try {
			const response = await fetch(`${import.meta.env.BASE_URL}/data/ccc/latest.json`);
			allData = await response.json();
			
			// Initial population of dropdowns
			updateAllDropdowns();
			applyFilters();
		} catch (error) {
			console.error('Failed to load data:', error);
			if (tableBody) {
				tableBody.innerHTML = '<tr><td colspan="5" class="error">Error loading data.</td></tr>';
			}
		}
	}

	function updateAllDropdowns() {
		const currentFilters = getCurrentFilters();
		
		updateDropdown(typeSelect, 'LICENSE_TYPE', currentFilters);
		updateDropdown(countySelect, 'ESTABLISHMENT_COUNTY', currentFilters);
		updateDropdown(citySelect, 'ESTABLISHMENT_CITY', currentFilters);
		updateDropdown(dbeSelect, 'DBE', currentFilters);
		updateDropdown(prioritySelect, 'PRIORITY_REVIEW_TYPE', currentFilters);
	}

	function getCurrentFilters() {
		return {
			searchTerm: searchInput.value.toLowerCase(),
			type: typeSelect.value,
			county: countySelect.value,
			city: citySelect.value,
			dbe: dbeSelect.value,
			priority: prioritySelect.value
		};
	}

	function updateDropdown(select: HTMLSelectElement, key: string, currentFilters: any) {
		const previousSelection = select.value;
		
		const possibleData = allData.filter(row => {
			const matchesSearch = !currentFilters.searchTerm || 
				(row.BUSINESS_NAME?.toLowerCase().includes(currentFilters.searchTerm)) ||
				(row.LICENSE_NUMBER?.toLowerCase().includes(currentFilters.searchTerm)) ||
				(row.ESTABLISHMENT_CITY?.toLowerCase().includes(currentFilters.searchTerm));
			
			const matchesType = key === 'LICENSE_TYPE' || !currentFilters.type || row.LICENSE_TYPE === currentFilters.type;
			const matchesCounty = key === 'ESTABLISHMENT_COUNTY' || !currentFilters.county || row.ESTABLISHMENT_COUNTY === currentFilters.county;
			const matchesCity = key === 'ESTABLISHMENT_CITY' || !currentFilters.city || row.ESTABLISHMENT_CITY === currentFilters.city;
			const matchesDbe = key === 'DBE' || !currentFilters.dbe || row.DBE === currentFilters.dbe;
			const matchesPriority = key === 'PRIORITY_REVIEW_TYPE' || !currentFilters.priority || row.PRIORITY_REVIEW_TYPE === currentFilters.priority;

			return matchesSearch && matchesType && matchesCounty && matchesCity && matchesDbe && matchesPriority;
		});

		const values = [...new Set(possibleData.map(item => item[key]))]
			.filter(v => v && v !== "")
			.sort();

		select.innerHTML = `<option value="">All ${key.split('_').pop()?.toLowerCase()}s</option>`;
		
		if (key === 'LICENSE_TYPE') select.firstChild!.textContent = 'All Types';
		if (key === 'DBE') select.firstChild!.textContent = 'All Statuses';
		if (key === 'PRIORITY_REVIEW_TYPE') select.firstChild!.textContent = 'All Priorities';

		values.forEach(val => {
			const opt = document.createElement('option');
			opt.value = val;
			opt.textContent = val;
			if (val === previousSelection) opt.selected = true;
			select.appendChild(opt);
		});
	}

	function applyFilters() {
		const filters = getCurrentFilters();

		filteredData = allData.filter(row => {
			const matchesSearch = !filters.searchTerm || 
				(row.BUSINESS_NAME?.toLowerCase().includes(filters.searchTerm)) ||
				(row.LICENSE_NUMBER?.toLowerCase().includes(filters.searchTerm)) ||
				(row.ESTABLISHMENT_CITY?.toLowerCase().includes(filters.searchTerm));
			
			const matchesType = !filters.type || row.LICENSE_TYPE === filters.type;
			const matchesCounty = !filters.county || row.ESTABLISHMENT_COUNTY === filters.county;
			const matchesCity = !filters.city || row.ESTABLISHMENT_CITY === filters.city;
			const matchesDbe = !filters.dbe || row.DBE === filters.dbe;
			const matchesPriority = !filters.priority || row.PRIORITY_REVIEW_TYPE === filters.priority;

			return matchesSearch && matchesType && matchesCounty && matchesCity && matchesDbe && matchesPriority;
		});

		currentPage = 1;
		updateAllDropdowns();
		renderTable();
	}

	function renderTable() {
		if (!tableBody) return;

		const total = filteredData.length;
		const totalPages = Math.ceil(total / itemsPerPage) || 1;
		
		if (currentPage > totalPages) currentPage = totalPages;

		const start = (currentPage - 1) * itemsPerPage;
		const end = Math.min(start + itemsPerPage, total);
		const pageData = filteredData.slice(start, end);

		if (pageData.length === 0) {
			tableBody.innerHTML = '<tr><td colspan="5" class="empty">No matching records found.</td></tr>';
			totalCountDisplay.textContent = '0';
			currentRangeDisplay.textContent = '0-0';
			pageInfoDisplay.textContent = '1 / 1';
			updatePaginationControls(1);
			return;
		}

		tableBody.innerHTML = pageData.map((row, idx) => `
			<tr data-license="${row.LICENSE_NUMBER}" class="clickable-row ${selectedLicenseNumber === row.LICENSE_NUMBER ? 'selected' : ''}">
				<td class="business-name">${row.BUSINESS_NAME || 'N/A'}</td>
				<td class="mono">${row.LICENSE_NUMBER || 'N/A'}</td>
				<td>${row.LICENSE_TYPE || 'N/A'}</td>
				<td>${row.ESTABLISHMENT_CITY || 'N/A'}</td>
				<td><span class="status-tag" data-status="${row.LICENSE_STATUS_CATEGORY?.toLowerCase()}">${row.LICENSE_STATUS || 'N/A'}</span></td>
			</tr>
		`).join('');

		totalCountDisplay.textContent = total.toString();
		currentRangeDisplay.textContent = `${total === 0 ? 0 : start + 1}-${end}`;
		pageInfoDisplay.textContent = `${currentPage} / ${totalPages}`;
		
		updatePaginationControls(totalPages);

		// Add click listeners to rows
		document.querySelectorAll('.clickable-row').forEach(row => {
			row.addEventListener('click', () => {
				const license = row.getAttribute('data-license');
				selectedLicenseNumber = license;
				
				const record = pageData.find(r => r.LICENSE_NUMBER === license);
				if (record) showDetails(record);
				
				// Highlight selected row
				document.querySelectorAll('.clickable-row').forEach(r => r.classList.remove('selected'));
				row.classList.add('selected');
			});
		});
	}

	function updatePaginationControls(totalPages: number) {
		prevBtn.disabled = currentPage <= 1;
		nextBtn.disabled = currentPage >= totalPages;
	}

	function showDetails(record: any) {
		if (!detailsContent) return;

		const priorityKeys = [
			'BUSINESS_NAME', 'LICENSE_NUMBER', 'LICENSE_TYPE', 'LICENSE_STATUS',
			'ESTABLISHMENT_ADDRESS_1', 'ESTABLISHMENT_CITY', 'ESTABLISHMENT_ZIP', 'ESTABLISHMENT_COUNTY',
			'BUSINESS_EMAIL', 'BUSINESS_PHONE',
			'DBE', 'PRIORITY_REVIEW_TYPE', 'APPROVED_LICENSE_STAGE', 'COMMENCE_OPERATIONS_DATE'
		];

		const entries = Object.entries(record).filter(([_, val]) => val && val !== "N/A" && val !== "");

		const sortedEntries = entries.sort(([keyA], [keyB]) => {
			const idxA = priorityKeys.indexOf(keyA);
			const idxB = priorityKeys.indexOf(keyB);
			
			if (idxA !== -1 && idxB !== -1) return idxA - idxB;
			if (idxA !== -1) return -1;
			if (idxB !== -1) return 1;
			return keyA.localeCompare(keyB);
		});

		detailsContent.innerHTML = sortedEntries
			.map(([key, value]) => `
				<div class="detail-item">
					<div class="detail-key">${key.replace(/_/g, ' ')}</div>
					<div class="detail-value">${value}</div>
				</div>
			`).join('');
	}

	// Event Listeners
	searchInput?.addEventListener('input', applyFilters);
	
	countySelect.addEventListener('change', () => {
		citySelect.value = '';
		applyFilters();
	});

	[typeSelect, citySelect, dbeSelect, prioritySelect].forEach(s => {
		s.addEventListener('change', applyFilters);
	});

	clearBtn?.addEventListener('click', () => {
		searchInput.value = '';
		typeSelect.value = '';
		countySelect.value = '';
		citySelect.value = '';
		dbeSelect.value = '';
		prioritySelect.value = '';
		selectedLicenseNumber = null;
		applyFilters();
		
		if (detailsContent) {
			detailsContent.innerHTML = '<div class="placeholder-msg">Select a record to view full details</div>';
		}
	});

	prevBtn?.addEventListener('click', () => {
		if (currentPage > 1) {
			currentPage--;
			renderTable();
		}
	});

	nextBtn?.addEventListener('click', () => {
		const totalPages = Math.ceil(filteredData.length / itemsPerPage);
		if (currentPage < totalPages) {
			currentPage++;
			renderTable();
		}
	});

	init();
</script>

<style>
	.archive-wrapper {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		height: calc(100vh - 10rem);
	}

	.data-browser {
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.controls {
		background: var(--surface-color);
		padding: 1rem;
		border: 1px solid var(--border-color);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.search-box {
		display: flex;
		gap: 1rem;
	}

	.search-box input {
		flex: 1;
		background: var(--bg-color);
		border: 1px solid var(--border-color);
		color: var(--text-base);
		padding: 0.5rem 0.75rem;
		font-family: var(--font-sans);
		font-size: 0.9rem;
	}

	.clear-btn {
		background: var(--bg-color);
		border: 1px solid var(--border-color);
		color: var(--text-muted);
		padding: 0 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		cursor: pointer;
		white-space: nowrap;
		transition: all 0.2s ease;
	}

	.clear-btn:hover {
		border-color: var(--text-base);
		color: var(--text-base);
		background: var(--surface-color);
	}

	.filters {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 0.75rem;
	}

	.filter-group {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.filter-group label {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.filter-group select {
		background: var(--bg-color);
		border: 1px solid var(--border-color);
		color: var(--text-base);
		padding: 0.35rem;
		font-family: var(--font-sans);
		font-size: 0.8rem;
	}

	.stats-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		padding: 0 0.25rem;
	}

	.pagination {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.pagination button {
		background: var(--surface-color);
		border: 1px solid var(--border-color);
		color: var(--text-base);
		padding: 0.2rem 0.6rem;
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
	}

	.pagination button:disabled {
		opacity: 0.3;
		cursor: not-allowed;
	}

	.table-scroll-container {
		flex: 1;
		overflow-y: auto;
		border: 1px solid var(--border-color);
		background: var(--bg-color);
	}

	table {
		width: 100%;
		border-collapse: collapse;
		text-align: left;
	}

	th {
		position: sticky;
		top: 0;
		background: var(--surface-color);
		padding: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		color: var(--text-muted);
		border-bottom: 2px solid var(--border-color);
		z-index: 10;
	}

	td {
		padding: 0.6rem 0.75rem;
		border-bottom: 1px solid var(--border-color);
		font-size: 0.85rem;
	}

	.clickable-row {
		cursor: pointer;
	}

	.clickable-row:hover {
		background: var(--surface-color);
	}

	/* High-contrast selection state */
	.clickable-row.selected {
		background: var(--accent-color) !important;
	}
	
	.clickable-row.selected td {
		color: var(--bg-color) !important;
		font-weight: 600;
	}
	
	.clickable-row.selected .status-tag {
		border-color: var(--bg-color);
		color: var(--bg-color);
	}

	.mono {
		font-family: var(--font-mono);
	}

	.business-name {
		font-weight: 600;
	}

	.status-tag {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		padding: 0.15rem 0.4rem;
		border: 1px solid var(--border-color);
		text-transform: uppercase;
	}

	.status-tag[data-status="active"] {
		border-color: var(--accent-color);
		color: var(--accent-color);
	}

	/* Bottom Pane Styles */
	.details-pane {
		height: 400px; /* Even taller */
		background: var(--surface-color);
		border: 1px solid var(--border-color);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.pane-header {
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--border-color);
		background: var(--bg-color);
	}

	.pane-header h2 {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: uppercase;
		color: var(--accent-color);
	}

	.details-content {
		padding: 1rem 1.5rem;
		overflow-y: auto;
		overflow-x: hidden;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1rem 2rem;
		align-items: flex-start;
		align-content: flex-start;
	}

	.placeholder-msg {
		color: var(--text-muted);
		font-style: italic;
		font-size: 0.9rem;
		grid-column: 1 / -1;
		text-align: center;
		padding: 4rem;
	}

	.detail-item {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		border-left: 2px solid var(--border-color);
		padding-left: 0.75rem;
	}

	.detail-key {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		font-weight: 700;
		text-transform: uppercase;
		color: var(--text-muted);
		letter-spacing: 0.05em;
	}

	.detail-value {
		font-size: 1rem;
		line-height: 1.2;
		word-break: break-word;
		color: var(--text-base);
	}

	@media (max-width: 768px) {
		.details-pane {
			height: 350px;
		}
		.details-content {
			grid-template-columns: 1fr;
		}
	}
</style>
