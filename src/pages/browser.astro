---
import Layout from '../components/Layout.astro';
import ArchiveTable from '../components/ArchiveTable.astro';
---

<Layout title="Data Browser">
	<header>
		<h1>Data Browser <span class="snapshot-info">/ Latest Snapshot: Massachusetts CCC Licenses</span></h1>
	</header>

	<ArchiveTable />
</Layout>

<style>
	header {
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 0.5rem;
	}

	h1 {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0;
		letter-spacing: -0.01em;
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}

	.snapshot-info {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		font-weight: 400;
	}
</style>
