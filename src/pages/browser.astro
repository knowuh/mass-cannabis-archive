---
import Layout from '../components/Layout.astro';
import ArchiveTable from '../components/ArchiveTable.astro';
---

<Layout title="Data Browser">
	<header>
		<h1>Data Browser <span class="snapshot-info">/ Latest Snapshot: Massachusetts CCC Licenses</span></h1>
		<div class="meta-info">
			Scraped: <span class="mono">2026-05-02 15:50 UTC</span> • 
			Built: <span class="mono">{new Date().toISOString().replace('T', ' ').slice(0, 16)} UTC</span>
		</div>
	</header>

	<ArchiveTable />
</Layout>

<style>
	header {
		margin-bottom: 0.75rem;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 0.25rem;
	}

	h1 {
		font-size: 1.1rem;
		font-weight: 700;
		margin: 0;
		letter-spacing: -0.01em;
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}

	.snapshot-info {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		font-weight: 400;
	}

	.meta-info {
		font-size: 0.6rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-top: 0.15rem;
		opacity: 0.7;
	}

	.mono {
		font-family: var(--font-mono);
	}
</style>
