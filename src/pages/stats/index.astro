---
import Layout from '../../components/Layout.astro';
import StatsDashboard from '../../components/StatsDashboard';
import { getEnrichedLicenses } from '../../utils/data';
import fs from 'node:fs/promises';
import path from 'node:path';

// --- Data Paths ---
const salesAdultPath = path.join(process.cwd(), 'data/ccc/current/sales-adult-use.json');
const salesMedPath = path.join(process.cwd(), 'data/ccc/current/sales-medical.json');
const salesDelPath = path.join(process.cwd(), 'data/ccc/current/sales-delivery.json');
const pricesPath = path.join(process.cwd(), 'data/ccc/current/prices.json');
const racePath = path.join(process.cwd(), 'data/ccc/current/agents-race.json');
const genderPath = path.join(process.cwd(), 'data/ccc/current/agents-gender.json');

// --- Helper: Load JSON ---
async function loadJSON(p) {
  try {
    const raw = await fs.readFile(p, 'utf-8');
    return JSON.parse(raw);
  } catch (e) {
    console.error(`Failed to load ${p}:`, e);
    return [];
  }
}

// --- Load Raw Data ---
const rawLicenses = await getEnrichedLicenses();
const rawSalesAdult = await loadJSON(salesAdultPath);
const rawSalesMed = await loadJSON(salesMedPath);
const rawSalesDel = await loadJSON(salesDelPath);
const rawPrices = await loadJSON(pricesPath);
const rawRace = await loadJSON(racePath);
const rawGender = await loadJSON(genderPath);

// --- Aggregation: Licenses ---
const licenseVelocity = Object.entries(
  rawLicenses
    .filter(d => d.COMMENCE_OPERATIONS_DATE)
    .reduce((acc, d) => {
      const month = d.COMMENCE_OPERATIONS_DATE.substring(0, 7); // YYYY-MM
      acc[month] = (acc[month] || 0) + 1;
      return acc;
    }, {})
).map(([date, count]) => ({ date, count })).sort((a, b) => a.date.localeCompare(b.date));

const marketComposition = Object.entries(
  rawLicenses.reduce((acc, d) => {
    acc[d.LICENSE_TYPE] = (acc[d.LICENSE_TYPE] || 0) + 1;
    return acc;
  }, {})
).map(([type, count]) => ({ type, count }));

const parentConcentration = Object.entries(
  rawLicenses
    .filter(d => d.EIN_TIN)
    .reduce((acc, d) => {
      if (!acc[d.EIN_TIN]) acc[d.EIN_TIN] = { name: d.BUSINESS_NAME, count: 0 };
      acc[d.EIN_TIN].count++;
      return acc;
    }, {})
)
  .map(([ein, data]) => ({ name: data.name, count: data.count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 10);

// --- Aggregation: Sales (Trends & Segment Split) ---
const aggregateSales = (data, segment) => {
  return data.reduce((acc, d) => {
    const month = d.SaleDate.substring(0, 7);
    const total = parseFloat(d["TOTAL_$"]) || 0;
    const key = `${month}|${segment}`;
    acc[key] = (acc[key] || 0) + total;
    return acc;
  }, {});
};

const salesByMonthSegment = {
  ...aggregateSales(rawSalesAdult, "Adult-Use"),
  ...aggregateSales(rawSalesMed, "Medical"),
  ...aggregateSales(rawSalesDel, "Delivery")
};

const segmentSplit = Object.entries(salesByMonthSegment).map(([key, total]) => {
  const [date, segment] = key.split('|');
  return { date, segment, total };
}).sort((a, b) => a.date.localeCompare(b.date));

// --- Aggregation: Cumulative Sales ---
const monthlyTotal = segmentSplit.reduce((acc, d) => {
  acc[d.date] = (acc[d.date] || 0) + d.total;
  return acc;
}, {});

let runningTotal = 0;
const cumulativeSales = Object.entries(monthlyTotal)
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([date, total]) => {
    runningTotal += total;
    return { date, total: runningTotal };
  });

const salesByCategory = rawSalesAdult.reduce((acc, d) => {
  const month = d.SaleDate.substring(0, 7);
  const cat = d.ProductCategoryName;
  const total = parseFloat(d["TOTAL_$"]) || 0;
  const key = `${month}|${cat}`;
  acc[key] = (acc[key] || 0) + total;
  return acc;
}, {});

const salesTrends = Object.entries(salesByCategory).map(([key, total]) => {
  const [date, category] = key.split('|');
  return { date, category, total };
});

const categoryMix = Object.entries(
  salesTrends.reduce((acc, d) => {
    acc[d.category] = (acc[d.category] || 0) + d.total;
    return acc;
  }, {})
)
  .map(([category, total]) => ({ category, total }))
  .sort((a, b) => b.total - a.total);

// --- Aggregation: Tax Estimates ---
const totalRevenue = cumulativeSales[cumulativeSales.length - 1]?.total || 0;
const taxEstimates = [
  { label: 'State Excise (10.75%)', value: totalRevenue * 0.1075, color: '#5a9f7a' },
  { label: 'State Sales (6.25%)', value: totalRevenue * 0.0625, color: '#437a5b' },
  { label: 'Local Option (3.00%)', value: totalRevenue * 0.03, color: '#2d3135' }
];

// --- Aggregation: Prices ---
const priceTrends = rawPrices.map(d => ({
  date: d.YEARMONTH,
  price: parseFloat(d.AVERAGERETAILPRICEPERGM)
}));

// --- Aggregation: Demographics ---
const raceData = rawRace.map(d => ({
  race: d.RACE_ETHNICITY,
  total: parseInt(d.TOTAL) || 0
}));

const genderData = rawGender.map(d => ({
  gender: d.GENDER,
  total: parseInt(d.TOTAL) || 0
}));

// --- Aggregation: Counties ---
const countyStats = Object.entries(
  rawLicenses
    .filter(d => d.ESTABLISHMENT_COUNTY)
    .reduce((acc, d) => {
      acc[d.ESTABLISHMENT_COUNTY] = (acc[d.ESTABLISHMENT_COUNTY] || 0) + 1;
      return acc;
    }, {})
)
  .map(([name, count]) => ({ 
    name, 
    count, 
    slug: name.toLowerCase().replace(/ /g, '-') 
  }))
  .sort((a, b) => b.count - a.count);

const aggregatedData = {
  licenseVelocity,
  marketComposition,
  parentConcentration,
  segmentSplit,
  salesTrends,
  cumulativeSales,
  categoryMix,
  taxEstimates,
  priceTrends,
  raceData,
  genderData
};
---

<Layout title="Market Statistics">
  <div class="stats-page-container">
    <header class="stats-header">
      <nav class="sub-nav">
        <a href="/mass-cannabis-archive/" class="nav-link">Data Browser</a>
        <span class="nav-link active">Market Statistics</span>
        <a href="https://weed-hunter.com/" target="_blank" rel="noopener noreferrer" class="nav-link">Live Prices ↗</a>
      </nav>
      <div class="title-group">
        <h1>Market Statistics</h1>
        <p class="subtitle">Aggregate trends and longitudinal analysis of the Massachusetts cannabis market.</p>
      </div>
    </header>

    <div class="stats-main">
      <StatsDashboard client:only="preact" data={aggregatedData} />
      
      <aside class="stats-sidebar">
        <section class="stat-card">
          <h3>Market By County</h3>
          <div class="county-list">
            {countyStats.map(county => (
              <a href={`/mass-cannabis-archive/county/${county.slug}`} class="county-row">
                <span class="county-name">{county.name}</span>
                <span class="county-count mono">{county.count}</span>
              </a>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .stats-page-container {
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    padding: var(--space-4) 0;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .stats-header {
    margin-bottom: var(--space-8);
    border-bottom: var(--border-width) solid var(--border-color);
    padding-bottom: var(--space-4);
  }

  .stats-main {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-8);
    align-items: flex-start;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding-right: var(--space-2);
  }

  .sub-nav {
    display: flex;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--accent-color);
    font-weight: 700;
    border-bottom: 2px solid var(--accent-color);
  }

  h1 {
    font-size: var(--font-size-xl);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .subtitle {
    font-size: var(--font-size-base);
    color: var(--text-muted);
    margin-top: var(--space-1);
  }

  .stats-sidebar {
    position: sticky;
    top: var(--space-4);
  }

  .stat-card {
    background: var(--surface-color);
    border: var(--border-width) solid var(--border-color);
    padding: var(--space-6);
  }

  .stat-card h3 {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    color: var(--accent-color);
    margin-bottom: var(--space-6);
    border-bottom: var(--border-width) solid var(--border-color);
    padding-bottom: var(--space-2);
  }

  .county-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .county-row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-2);
    text-decoration: none;
    color: var(--text-base);
    font-size: var(--font-size-sm);
    border-bottom: 1px solid var(--border-color);
    transition: background 0.2s ease;
  }

  .county-row:hover {
    background: var(--bg-color);
    color: var(--accent-color);
  }

  .mono {
    font-family: var(--font-mono);
  }

  @media (max-width: 1100px) {
    .stats-main {
      grid-template-columns: 1fr;
    }
    .stats-sidebar {
      position: static;
    }
  }
</style>
