---
import Layout from '../../components/Layout.astro';
import fs from 'node:fs/promises';
import path from 'node:path';

export async function getStaticPaths() {
  const licensesPath = path.join(process.cwd(), 'data/ccc/current/licenses.json');
  const raw = await fs.readFile(licensesPath, 'utf-8');
  const licenses = JSON.parse(raw);
  
  const licenseMap = new Map(licenses.map(l => [l.LICENSE_NUMBER, l]));
  
  const changelogDir = path.join(process.cwd(), 'data/changelog/by-license');
  let historicalLicenseNumbers = [];
  try {
    const files = await fs.readdir(changelogDir);
    historicalLicenseNumbers = files
      .filter(file => file.endsWith('.jsonl'))
      .map(file => file.replace('.jsonl', ''));
  } catch (e) {
    console.error('Error reading changelogs:', e);
  }

  const allLicenseNumbers = [...new Set([
    ...licenseMap.keys(),
    ...historicalLicenseNumbers
  ])];

  return allLicenseNumbers.map(ln => {
    return {
      params: { license_number: ln },
      props: { currentRecord: licenseMap.get(ln) || null }
    };
  });
}

const { license_number } = Astro.params;
const { currentRecord } = Astro.props;

// Read and parse JSONL if it exists
let events = [];
try {
  const changelogPath = path.join(process.cwd(), 'data/changelog/by-license', `${license_number}.jsonl`);
  const content = await fs.readFile(changelogPath, 'utf-8');
  events = content
    .trim()
    .split('\n')
    .filter(line => line.trim())
    .map(line => JSON.parse(line))
    .reverse(); // Newest first
} catch (e) {
  // No historical logs yet
}

const entityName = currentRecord?.BUSINESS_NAME || events[0]?.entity_name || 'Unknown Entity';

function formatDate(ts) {
  return new Date(ts).toISOString().split('T')[0];
}

function formatType(type) {
  return type.replace(/_/g, ' ').toUpperCase();
}

const statusGroups = [
  {
    title: 'License Lifecycle',
    keys: ['LICENSE_STATUS', 'APPROVED_LICENSE_STAGE', 'COMMENCE_OPERATIONS_DATE', 'LIC_EXPIRATION_DATE', 'LIC_ORIGINAL_START_DATE']
  },
  {
    title: 'Location & Contact',
    keys: ['ESTABLISHMENT_ADDRESS_1', 'ESTABLISHMENT_CITY', 'ESTABLISHMENT_ZIP', 'ESTABLISHMENT_COUNTY', 'BUSINESS_EMAIL', 'BUSINESS_PHONE']
  }
];
---

<Layout title={`${entityName} - History`}>
  <div class="history-container">
    <header class="history-header">
      <a href="/mass-cannabis-archive/" class="back-link">← Back to Browser</a>
      <div class="title-group">
        <h1>{entityName}</h1>
        <div class="license-badge mono">{license_number}</div>
      </div>
    </header>

    {currentRecord && (
      <section class="current-status-section">
        <h2>Current License Details</h2>
        <div class="status-grid">
          {statusGroups.map(group => {
            const items = Object.entries(currentRecord)
              .filter(([key, val]) => group.keys.includes(key) && val && val !== "N/A" && val !== "")
              .sort((a, b) => group.keys.indexOf(a[0]) - group.keys.indexOf(b[0]));
            
            if (items.length === 0) return null;

            return (
              <div class="status-group" key={group.title}>
                <h3>{group.title}</h3>
                <div class="group-items">
                  {items.map(([key, value]) => (
                    <div class="detail-item" key={key}>
                      <div class="detail-key">{key.replace(/_/g, ' ')}</div>
                      <div class="detail-value">{value}</div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <section class="timeline-section">
      <h2>Transaction History</h2>
      {events.length > 0 ? (
        <div class="timeline">
          {events.map((event, index) => (
            <div class="timeline-item">
              <div class="timeline-marker"></div>
              <div class="timeline-content">
                <div class="event-meta mono">
                  <span class="event-date">{formatDate(event.ts)}</span>
                  <span class="event-type">{formatType(event.type)}</span>
                </div>
                
                <div class="event-details">
                  {event.type === 'field_changed' && (
                    <div class="field-change">
                      <span class="field-name mono">{event.field.replace(/_/g, ' ')}</span>
                      <div class="change-values">
                        <span class="old-value">{event.old_value || 'None'}</span>
                        <span class="arrow">→</span>
                        <span class="new-value">{event.new_value}</span>
                      </div>
                    </div>
                  )}
                  
                  {event.type === 'entity_added' && (
                    <div class="entity-added">
                      License first appeared in CCC dataset.
                      {event.record && (
                        <div class="initial-fields mono">
                          {Object.entries(event.record).map(([k, v]) => (
                            <div class="initial-field">{k}: {v}</div>
                          ))}
                        </div>
                      )}
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="no-history">
          <p>No historical transaction records found for this entity.</p>
          <p class="muted">The archive began tracking this license's evolution recently, or no state changes have occurred since the initial crawl.</p>
        </div>
      )}
    </section>
  </div>
</Layout>

<style>
  .history-container {
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
    padding: var(--space-4) 0;
  }

  .history-header {
    margin-bottom: var(--space-8);
    border-bottom: var(--border-width) solid var(--border-color);
    padding-bottom: var(--space-6);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    margin-bottom: var(--space-6);
    color: var(--text-muted);
  }

  .title-group {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  h1 {
    font-size: var(--font-size-xl);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .license-badge {
    background: var(--surface-color);
    border: var(--border-width) solid var(--border-color);
    padding: var(--space-1) var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--accent-color);
  }

  section {
    margin-bottom: var(--space-12);
  }

  h2 {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-6);
    border-bottom: var(--border-width) solid var(--border-color);
    padding-bottom: var(--space-2);
  }

  .current-status-section {
    background: var(--surface-color);
    border: var(--border-width) solid var(--border-color);
    padding: var(--space-6);
  }

  .status-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .status-group h3 {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
    opacity: 0.7;
  }

  .group-items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4);
  }

  .detail-item {
    border-left: 2px solid var(--border-color);
    padding-left: var(--space-3);
  }

  .detail-key {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 2px;
  }

  .detail-value {
    font-size: var(--font-size-sm);
    color: var(--text-base);
  }

  .timeline {
    position: relative;
    padding-left: var(--space-8);
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border-color);
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-12);
  }

  .timeline-marker {
    position: absolute;
    left: -25px;
    top: 5px;
    width: 16px;
    height: 16px;
    background: var(--bg-color);
    border: 3px solid var(--accent-color);
    border-radius: 50%;
    z-index: 1;
  }

  .event-meta {
    display: flex;
    gap: var(--space-4);
    font-size: var(--font-size-xs);
    margin-bottom: var(--space-2);
  }

  .event-date {
    color: var(--text-base);
    font-weight: 700;
  }

  .event-type {
    color: var(--text-muted);
    background: var(--surface-color);
    padding: 0 4px;
  }

  .field-change {
    background: var(--surface-color);
    border: var(--border-width) solid var(--border-color);
    padding: var(--space-4);
  }

  .field-name {
    display: block;
    font-size: var(--font-size-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .change-values {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--font-size-base);
  }

  .old-value {
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .new-value {
    color: var(--text-base);
    font-weight: 600;
  }

  .arrow {
    color: var(--accent-color);
  }

  .entity-added {
    font-size: var(--font-size-base);
    color: var(--text-muted);
    font-style: italic;
  }

  .initial-fields {
    margin-top: var(--space-4);
    font-size: var(--font-size-xs);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-2);
  }

  .initial-field {
    border-left: 2px solid var(--border-color);
    padding-left: var(--space-2);
  }

  .no-history {
    background: var(--surface-color);
    border: var(--border-width) solid var(--border-color);
    padding: var(--space-8);
    text-align: center;
  }

  .no-history p {
    margin: 0;
    font-size: var(--font-size-base);
  }

  .no-history .muted {
    margin-top: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--text-muted);
  }
</style>
