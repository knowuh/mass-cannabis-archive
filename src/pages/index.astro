---
import Layout from '../components/Layout.astro';
import ArchiveTable from '../components/ArchiveTable.astro';
---

<Layout title="Data Browser">
	<header class="main-header">
		<div class="title-group">
			<h1>Mass Cannabis Archive <span class="browser-label">Data Browser</span></h1>
			<div class="meta-info">
				Scraped: <span class="mono">2026-05-02 15:50 UTC</span> • 
				Built: <span class="mono">{new Date().toISOString().replace('T', ' ').slice(0, 16)} UTC</span>
			</div>
		</div>
		<button id="info-trigger" class="info-btn" aria-label="Project Information">Info</button>
	</header>

	<ArchiveTable />

	<div id="info-overlay" class="overlay hidden">
		<div class="overlay-content">
			<button id="info-close" class="close-btn">&times;</button>
			<section class="manifesto">
				<h2>Project Manifesto</h2>
				<p>
					The Massachusetts Cannabis Control Commission (CCC) provides public data, but historical context is often lost as files are updated and overwritten. This project serves as a permanent, version-controlled archive of that data.
				</p>
				<p>
					Our goal is transparency and accessibility. By snapshotting data over time, we enable researchers, journalists, and the public to track the evolution of licenses, ownership, and market dynamics in the Commonwealth.
				</p>
				<div class="safety-info">
					<p><strong>Public Health & Safety:</strong> MA Substance Use Helpline: <a href="tel:800-327-5050">800-327-5050</a></p>
					<p class="disclaimer">This is an independent archive of public data. Not affiliated with the CCC.</p>
				</div>
			</section>
		</div>
	</div>
</Layout>

<script>
	const trigger = document.getElementById('info-trigger');
	const overlay = document.getElementById('info-overlay');
	const close = document.getElementById('info-close');

	trigger?.addEventListener('click', () => {
		overlay?.classList.remove('hidden');
	});

	close?.addEventListener('click', () => {
		overlay?.classList.add('hidden');
	});

	overlay?.addEventListener('click', (e) => {
		if (e.target === overlay) {
			overlay.classList.add('hidden');
		}
	});
</script>

<style>
	.main-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--space-2);
		border-bottom: var(--border-width) solid var(--border-color);
		padding-bottom: var(--space-2);
	}

	h1 {
		font-size: var(--font-size-lg);
		font-weight: 700;
		margin: 0;
		letter-spacing: -0.01em;
	}

	.browser-label {
		color: var(--text-muted);
		font-weight: 400;
		margin-left: var(--space-1);
	}

	.meta-info {
		font-size: var(--font-size-xs);
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-top: 0.15rem;
		opacity: 0.7;
	}

	.mono {
		font-family: var(--font-mono);
	}

	.info-btn {
		background: var(--surface-color);
		border: var(--border-width) solid var(--border-color);
		color: var(--text-base);
		padding: 0.35rem 0.75rem;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.info-btn:hover {
		border-color: var(--accent-color);
		color: var(--accent-color);
	}

	/* Overlay Styles */
	.overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(4px);
		display: flex;
		justify-content: center;
		align-items: center;
		z-index: 1000;
		padding: var(--space-8);
	}

	.overlay.hidden {
		display: none;
	}

	.overlay-content {
		background: var(--surface-color);
		border: var(--border-width) solid var(--border-color);
		max-width: 600px;
		width: 100%;
		padding: var(--space-12);
		position: relative;
	}

	.close-btn {
		position: absolute;
		top: var(--space-4);
		right: var(--space-6);
		background: none;
		border: none;
		color: var(--text-muted);
		font-size: var(--font-size-xxl);
		cursor: pointer;
	}

	.close-btn:hover {
		color: var(--text-base);
	}

	.manifesto h2 {
		font-family: var(--font-mono);
		font-size: var(--font-size-md);
		text-transform: uppercase;
		color: var(--accent-color);
		margin-top: 0;
		margin-bottom: var(--space-8);
	}

	.manifesto p {
		font-size: var(--font-size-lg);
		line-height: 1.6;
		margin-bottom: var(--space-6);
	}

	.safety-info {
		margin-top: var(--space-12);
		padding-top: var(--space-8);
		border-top: var(--border-width) solid var(--border-color);
		font-size: var(--font-size-base);
	}

	.safety-info a {
		color: var(--accent-color);
		text-decoration: none;
		font-weight: 600;
	}

	.disclaimer {
		font-style: italic;
		color: var(--text-muted);
		margin-top: var(--space-4);
	}
</style>
